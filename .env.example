# Copiá este archivo como .env.local (local) y cargá las mismas variables en Vercel (Settings → Environment Variables).
# Son claves PÚBLICAS (anon): se incluyen en el sitio. NUNCA pongas aquí la clave service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Opcional: pedir versiones redimensionadas (requiere un plan de Supabase con transformación de imágenes)
# VITE_SUPABASE_IMAGE_TRANSFORM=true
